# Get a key at https://aistudio.google.com  ->  Get API key
# Leave blank to run in rule-based mode.
GEMINI_API_KEY=

# Optional. Any Gemini model that supports function calling.
GEMINI_MODEL=gemini-3.8-flash

PORT=3000

# ---- Only needed when the chat page is hosted somewhere else ----
# The website(s) allowed to call this server, comma-separated. Exact match, no trailing slash.
# e.g. ALLOWED_ORIGINS=https://yourname.github.io
ALLOWED_ORIGINS=

# Set to 1 when running behind Tailscale Funnel, Render, or another proxy,
# so rate limits see each visitor's real IP instead of the proxy's.
TRUST_PROXY=

# Messages per visitor per minute before they're asked to slow down.
RATE_LIMIT_PER_MIN=30
